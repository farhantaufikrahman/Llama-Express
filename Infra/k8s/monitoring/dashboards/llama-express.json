        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(jvm_memory_used_bytes{namespace=\"llama\", job=\"backend\", area=\"heap\"})",
          "legendFormat": "used"
