    {
      "type": "timeseries",
      "title": "Latency rata-rata Redis & DB acquire",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(lettuce_seconds_sum{namespace=\"llama\", job=\"backend\"}[5m])) / clamp_min(sum(rate(lettuce_seconds_count{namespace=\"llama\", job=\"backend\"}[5m])), 1e-9)",
          "legendFormat": "Redis command"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{namespace=\"llama\", job=\"backend\"}[5m])) / clamp_min(sum(rate(hikaricp_connections_acquire_seconds_count{namespace=\"llama\", job=\"backend\"}[5m])), 1e-9)",
          "legendFormat": "DB acquire"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
