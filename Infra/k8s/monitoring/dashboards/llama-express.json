              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Outbox pending",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
