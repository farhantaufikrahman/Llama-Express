          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(jvm_memory_max_bytes{namespace=\"llama\", job=\"backend\", area=\"heap\"} > 0)",
          "legendFormat": "max"
        }
