# File ini diproses envsubst saat container start → ${BACKEND_URL} diganti nilai env.
# Variabel Nginx ($host, $uri, …) tidak tersentuh karena tidak didefinisikan sebagai env.

# Header "Connection" yang benar untuk WebSocket: "upgrade" bila klien meminta, selain itu "close"
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;                      # image unprivileged → tidak boleh port < 1024
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;                # sembunyikan versi Nginx dari header & halaman error
    client_max_body_size 10m;         # upload foto bukti kurir (sudah dikompres di browser)

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # ---------- API ----------
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;   # $http_host = host + PORT (Spring butuh untuk cek same-origin)
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---------- WebSocket (STOMP) ----------
    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;                          # Upgrade hanya ada di HTTP/1.1
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;                           # koneksi panjang; heartbeat STOMP 10 detik menjaga tetap hidup
        proxy_send_timeout 1h;
    }

    # ---------- Health check untuk Docker / Kubernetes ----------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------- Aset ber-hash: cache 1 tahun ----------
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;          # aset hilang = 404, JANGAN dibalas index.html (menyamarkan error deploy)
    }

    # ---------- index.html: jangan pernah di-cache ----------
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # ---------- SPA fallback: /orders/LX-123 → index.html, React Router yang menangani ----------
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}